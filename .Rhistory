rm(list=ls())
library(betareg)
library(ggplot2)
library(numDeriv)
source("routines_tpbetareg.R")
####################################################################################
# Example
####################################################################################
# Using betareg
library(betareg)
data("GasolineYield", package = "betareg")
head(GasolineYield)
n <- nrow(GasolineYield)
## Table 1
gy <- betareg(yield ~ batch + temp, data = GasolineYield, link = "logit")
summary(gy)
# Direct implementation
Xb <- matrix(0, ncol = 10, nrow = n)
Xb[cbind(1:n,GasolineYield$batc)] <- 1
X <- cbind(1,Xb[,1:9],GasolineYield$temp)
y <- GasolineYield$yield
# It is recommended to use different methods and initial points
OPT <- MLEBR(y = y, des = X, init = rep(0,12), method = "nlminb", control = list( iter.max = 10000))
OPT2 <- MLETPBR(y = y, des = X, init = rep(0,13), method = "nlminb", control = list( iter.max = 10000))
rm(list=ls())
library(betareg)
library(ggplot2)
library(numDeriv)
library(twopiece)
source("routines_tpbetareg.R")
####################################################################################
# Example
####################################################################################
# Using betareg
library(betareg)
data("GasolineYield", package = "betareg")
head(GasolineYield)
n <- nrow(GasolineYield)
## Table 1
gy <- betareg(yield ~ batch + temp, data = GasolineYield, link = "logit")
summary(gy)
# Direct implementation
Xb <- matrix(0, ncol = 10, nrow = n)
Xb[cbind(1:n,GasolineYield$batc)] <- 1
X <- cbind(1,Xb[,1:9],GasolineYield$temp)
y <- GasolineYield$yield
# It is recommended to use different methods and initial points
OPT <- MLEBR(y = y, des = X, init = rep(0,12), method = "nlminb", control = list( iter.max = 10000))
OPT2 <- MLETPBR(y = y, des = X, init = rep(0,13), method = "nlminb", control = list( iter.max = 10000))
# Comparison
cbind(coef(gy),OPT$MLE)
c(gy$loglik, - OPT$OPT$objective)
OPT$loglik(c(coef(gy)[1:11],log(coef(gy)[12])))
OPT$loglik(OPT$OPT$par)
# Model comparison
c(OPT$AIC, OPT2$AIC)
c(OPT$BIC, OPT2$BIC)
c(gy$loglik, - OPT$OPT$objective)
OPT$loglik(c(coef(gy)[1:11],log(coef(gy)[12])))
OPT$loglik(c(coef(gy)[1:11],log(coef(gy)[12])))
OPT$loglik(OPT$OPT$par)
#--------------------------------------------------------------------------------
# probability density function of the twopiece beta distribution
#--------------------------------------------------------------------------------
# parameterised in terms of the mean (mu), phi, and gamma
# mu: mean (0,1)
# phi: positive parameter
# gamma: skewness parameter (-1,1)
# log: logical; if TRUE, probabilities p are given as log(p).
dtpbetamv <- function(x, mu, phi, gamma, log = FALSE) {
mu2 <- tpexpit(mu, gamma0)
logpdf <- lgamma(phi) - lgamma(mu2*phi) - lgamma((1-mu2)*phi) +
(mu2*phi-1)*log(x) + ((1-mu2)*phi-1)*log(1-x)
out <- ifelse(log, logpdf, exp(logpdf))
return(out)
}
mu0 = 0.5
phi0 = 10
gamma0 = 0
tempf <- Vectorize(function(x) dtpbetamv(x, mu0, phi0, gamma0, log = FALSE) )
tempf0 <- Vectorize(function(x) dbetamv(x, mu0, phi0, log = FALSE) )
tempf <- Vectorize(function(x) dtpbetamv(x, mu0, phi0, gamma0, log = FALSE) )
curve(tempf0,0,1,n=1000, lwd = 2)
curve(tempf,0,1,n=1000, lwd = 2, lty = 2, add =TRUE)
mu0 = 0.5
phi0 = 10
gamma0 = 0
tempf0 <- Vectorize(function(x) dbetamv(x, mu0, phi0, log = FALSE) )
tempf <- Vectorize(function(x) dtpbetamv(x, mu0, phi0, gamma0, log = FALSE) )
curve(tempf0,0,1,n=1000, lwd = 2)
curve(tempf,0,1,n=1000, lwd = 2, lty = 2, add =TRUE)
dtpbetamv <- function(x, mu, phi, shape, log = FALSE) {
mu2 <- tpexpit(mu, shape)
logpdf <- lgamma(phi) - lgamma(mu2*phi) - lgamma((1-mu2)*phi) +
(mu2*phi-1)*log(x) + ((1-mu2)*phi-1)*log(1-x)
out <- ifelse(log, logpdf, exp(logpdf))
return(out)
}
mu0 = 0.5
phi0 = 10
gamma0 = 0
tempf0 <- Vectorize(function(x) dbetamv(x, mu0, phi0, log = FALSE) )
tempf <- Vectorize(function(x) dtpbetamv(x, mu0, phi0, gamma0, log = FALSE) )
curve(tempf0,0,1,n=1000, lwd = 2)
curve(tempf,0,1,n=1000, lwd = 2, lty = 2, add =TRUE)
dtpbetamv <- function(x, mu, phi, shape, log = FALSE) {
mu2 <- tpexpit( logit(mu), shape)
logpdf <- lgamma(phi) - lgamma(mu2*phi) - lgamma((1-mu2)*phi) +
(mu2*phi-1)*log(x) + ((1-mu2)*phi-1)*log(1-x)
out <- ifelse(log, logpdf, exp(logpdf))
return(out)
}
mu0 = 0.5
phi0 = 10
gamma0 = 0
tempf0 <- Vectorize(function(x) dbetamv(x, mu0, phi0, log = FALSE) )
tempf <- Vectorize(function(x) dtpbetamv(x, mu0, phi0, gamma0, log = FALSE) )
curve(tempf0,0,1,n=1000, lwd = 2)
curve(tempf,0,1,n=1000, lwd = 2, lty = 2, add =TRUE)
